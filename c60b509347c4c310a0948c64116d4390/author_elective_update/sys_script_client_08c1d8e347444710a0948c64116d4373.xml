<?xml version="1.0" encoding="UTF-8"?><record_update sys_domain="global" table="sys_script_client">
    <sys_script_client action="DELETE">
        <active>true</active>
        <applies_extended>false</applies_extended>
        <condition/>
        <description>Create a client script that makes incident state "Closed" not selectable for anyone who holds "itil" role.</description>
        <field>state</field>
        <global>true</global>
        <isolate_script>false</isolate_script>
        <messages/>
        <name>Disable Closed State</name>
        <order/>
        <script><![CDATA[function onLoad() {
	if(g_user.hasRoleExactly('itil')) {
		var stateFieldName = 'state';

		if(g_form.getValue(stateFieldName) == 7) {
			g_form.setValue(stateFieldName, '1');
		}

		// g_form.disableChoice('state', '7'); NOT WORKING
		// https://servicenowguru.com/client-scripts-scripting/removing-disabling-choice-list-options/
		g_form.removeOption(stateFieldName, '7');
		g_form.showFieldMsg(stateFieldName, 'Ok Pk', 'warning');
		
		getMessage(
			'custom_you_cannot_select_closed_state',
			function(translations) {
				debugger
				console.log('Here');
				g_form.showFieldMsg(stateFieldName, translations || 'You', 'warning');
			}
		);
	}
}]]></script>
